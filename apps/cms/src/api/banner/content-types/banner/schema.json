{
  "kind": "collectionType",
  "collectionName": "banners",
  "info": {
    "singularName": "banner",
    "pluralName": "banners",
    "displayName": "Marketing Banner",
    "description": "Carousel and campaign promotional banners"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "targetUrl": {
      "type": "string"
    },
    "targetAudience": {
      "type": "enumeration",
      "enum": [
        "CUSTOMER",
        "SHIPPER",
        "RESTAURANT",
        "ALL"
      ],
      "default": "CUSTOMER"
    },
    "displayOrder": {
      "type": "integer",
      "default": 0
    },
    "activeFrom": {
      "type": "datetime"
    },
    "activeTo": {
      "type": "datetime"
    },
    "isActive": {
      "type": "boolean",
      "default": true
    },
    "image": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    }
  }
}
