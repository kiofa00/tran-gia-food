{
  "kind": "collectionType",
  "collectionName": "faq_items",
  "info": {
    "singularName": "faq-item",
    "pluralName": "faq-items",
    "displayName": "Help Center FAQ Item",
    "description": "Frequently asked questions and support guides"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "question": {
      "type": "string",
      "required": true
    },
    "answer": {
      "type": "richtext",
      "required": true
    },
    "category": {
      "type": "enumeration",
      "enum": ["ORDERING", "PAYMENT", "DELIVERY", "ACCOUNT", "PARTNER"],
      "default": "ORDERING"
    },
    "targetApp": {
      "type": "enumeration",
      "enum": ["CUSTOMER", "SHIPPER", "RESTAURANT"],
      "default": "CUSTOMER"
    },
    "displayOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
