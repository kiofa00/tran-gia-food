{
  "kind": "collectionType",
  "collectionName": "translations",
  "info": {
    "singularName": "translation",
    "pluralName": "translations",
    "displayName": "Dynamic Translation & Text Copy",
    "description": "Universal dynamic text labels and i18n dictionary for all apps"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "vi": {
      "type": "text",
      "required": true
    },
    "en": {
      "type": "text"
    },
    "appTarget": {
      "type": "enumeration",
      "enum": ["CUSTOMER", "SHIPPER", "RESTAURANT", "ADMIN_WEB", "ALL"],
      "default": "ALL",
      "required": true
    },
    "category": {
      "type": "string",
      "default": "GENERAL"
    }
  }
}
