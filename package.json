{
  "name": "tran_gia_app",
  "version": "1.0.0",
  "private": true,
  "description": "Tran Gia Food Delivery Platform - Hybrid Monorepo (Flutter + NestJS + Next.js)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.15.9"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:backend": "pnpm --filter=backend run start:dev",
    "dev:admin": "pnpm --filter=admin_web run dev",
    "dev:cms": "pnpm --filter=cms run dev",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:migrate": "pnpm --filter=backend run prisma:migrate",
    "db:seed": "pnpm --filter=backend run prisma:seed",
    "db:studio": "pnpm --filter=backend run prisma:studio",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:check": "pnpm -r run lint:check",
    "test": "pnpm -r run test",
    "test:flutter": "melos test",
    "test:all": "pnpm -r run test && melos test",
    "clean": "pnpm -r run clean",
    "melos:bootstrap": "melos bootstrap",
    "melos:analyze": "melos analyze",
    "melos:gen": "melos gen"
  },
  "devDependencies": {
    "turbo": "catalog:"
  }
}
