{
  "name": "tran_gia_app",
  "version": "1.0.0",
  "private": true,
  "description": "Tran Gia Food Delivery Platform - Hybrid Monorepo (Flutter + NestJS + Next.js)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.15.9"
  },
