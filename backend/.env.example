# =============================================
# DATABASE
# =============================================
DATABASE_URL="postgresql://admin:password123@localhost:5432/tran_gia_food?schema=public"

# =============================================
# REDIS
# =============================================
REDIS_URL="redis://localhost:6379"

# =============================================
# JWT
# =============================================
JWT_SECRET="change-me-to-a-very-long-random-string-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="another-very-long-random-string-for-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# =============================================
# APP
# =============================================
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# =============================================
# GOOGLE OAUTH
# =============================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# =============================================
# FACEBOOK OAUTH
# =============================================
FACEBOOK_APP_ID="your-facebook-app-id"
FACEBOOK_APP_SECRET="your-facebook-app-secret"
FACEBOOK_CALLBACK_URL="http://localhost:3000/auth/facebook/callback"

# =============================================
# SMS OTP (ESMS.vn cho thị trường VN)
# =============================================
ESMS_API_KEY="your-esms-api-key"
ESMS_API_SECRET="your-esms-secret"
ESMS_BRAND_NAME="TranGiaFood"
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5

# =============================================
# FIREBASE (Push Notification + Storage)
# =============================================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"
FIREBASE_STORAGE_BUCKET="your-project.appspot.com"

# =============================================
# SENDGRID (Email)
# =============================================
SENDGRID_API_KEY="SG.your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@trangiafood.com"
SENDGRID_FROM_NAME="Tran Gia Food"

# =============================================
# GOOGLE MAPS
# =============================================
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# =============================================
# PAYMENT
# =============================================
MOMO_PARTNER_CODE="your-momo-partner-code"
MOMO_ACCESS_KEY="your-momo-access-key"
MOMO_SECRET_KEY="your-momo-secret-key"
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

VNPAY_TMN_CODE="your-vnpay-tmn-code"
VNPAY_HASH_SECRET="your-vnpay-hash-secret"
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
